# Virtual environments
# NOTE: .python_packages/ must NOT be ignored here. The deploy pipeline installs
# dependencies into .python_packages/lib/site-packages before packaging, and this
# app deploys via an external-URL WEBSITE_RUN_FROM_PACKAGE (Oryx build is skipped).
# Excluding this folder strips all deps from the zip, causing "0 functions loaded".
.venv/
.venv311/
venv/

# Local configuration and secrets
local.settings.json
.env/
.azure-personal/

# Local data and dev-only folders
local_data/
package_extracted/
test_mode_data/

# Local Azure SDK stub (must never be deployed)
# (shadows the real azure-functions/azure-identity/azure-storage-blob packages)
azure/

# Application bundles and artifacts
app.zip
app_clean.zip

# Local-only scripts and generated files
run_auth.py
run_once.py
run_expiry_flow.py
summary_oi_data.py

# Python cache and test artifacts
__pycache__/
*.pyc
.pytest_cache/
*.pytest_cache/

# Logs
*.log

# Large data and DB files
*.parquet
*.sqlite
*.db

# Editor / IDE
.vscode/

# VCS and GitHub
.git/
.github/

# Tests
tests/

# Build / packaging
coverage/
dist/
build/

# End of file