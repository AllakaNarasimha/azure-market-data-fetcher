# Virtual environments
# .python_packages/ intentionally NOT listed: deploy pipeline vendors deps there.
.venv/
.venv311/
venv/

# Local configuration and secrets
local.settings.json
.env/
.azure-personal/

# Local data and dev-only folders
local_data/
package_extracted/
test_mode_data/
# Local index-generation output (mirrors the "market-data-cache" blob container
# name on disk when AzureBlobMarketIndexer runs locally) - not read by the schedulers.
market-data-cache/
# Manual, standalone dev utilities - not imported by function_app.py's triggers.
scripts/
docs/

# Local Azure SDK stub (must never be deployed)
# (shadows the real azure-functions/azure-identity/azure-storage-blob packages)
# NOTE: leading slash anchors this to the repo root only. Without it, this pattern
# also matches .python_packages/lib/site-packages/azure/ (the real vendored SDK),
# stripping azure.identity/azure.storage.blob from the deploy zip -> 0 functions loaded.
/azure/

# Application bundles and artifacts
app.zip
app_clean.zip

# Local-only scripts and generated files
run_auth.py
run_once.py
run_expiry_flow.py
summary_oi_data.py

# Test suite - only needed at CI/build time (pytest step), never at runtime
tests/

stock_arrival_summary.csv
test_stock_arrival_summary.csv
notes.txt
broker_authenticate.notes.md
# Only referenced from function_app.py's local `__main__` dev block, never on the
# LiveScheduler/DailyScheduler code path, so not required to host the schedulers.
azure_blob_market_indexer.py
# Only consumed by azure_blob_market_indexer.py (see above).
df_utils.py
# Not imported anywhere in the codebase; unused/dead module.
trading_servicebus_manager.py

# Python cache and test artifacts
__pycache__/
*.pyc
.pytest_cache/
*.pytest_cache/

# Logs
*.log

# Large data and DB files
*.parquet
*.sqlite
*.db

# Editor / IDE
.vscode/

# VCS and GitHub
.git/
.github/

# Tests
tests/

# Build / packaging
coverage/
dist/
build/

